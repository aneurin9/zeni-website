{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeni-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
